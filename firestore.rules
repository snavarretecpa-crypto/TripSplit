rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A trip can be opened only by someone who has its 22-character link.
    // Nobody can list all trips, and trips cannot be deleted from the app.
    match /trips/{tripId} {
      allow get, create, update: if tripId.size() >= 20;
      match /expenses/{expenseId} {
        allow read, write: if tripId.size() >= 20;
      }
    }
  }
}
